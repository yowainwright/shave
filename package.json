{
  "name": "shave",
  "version": "5.2.0",
  "description": "Shave is a javascript plugin that truncates multi-line text within a html element based on set max height",
  "main": "dist/shave.cjs",
  "module": "dist/shave.mjs",
  "type": "module",
  "unpkg": "dist/shave.global.js",
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "files": [
    "dist",
    "src",
    "types"
  ],
  "types": "dist/shave.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shave.d.ts",
      "import": "./dist/shave.mjs",
      "require": "./dist/shave.cjs",
      "default": "./dist/shave.mjs"
    },
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:dist && pnpm build:types",
    "build:dist": "rolldown --config scripts/rolldown.config.ts",
    "build:types": "tsc",
    "clean": "rm -rf dist types",
    "deps:check": "codependence --dryRun && pastoralist doctor",
    "deps:update": "codependence --update",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "pre-commit": "pnpm run build && pnpm run test && pnpm run test:size && pnpm run lint && pnpm run format:check",
    "prepare": "bash scripts/setup.sh --hooks-only",
    "prepublishOnly": "pnpm build && pnpm run test && pnpm run test:size",
    "setup": "bash scripts/setup.sh",
    "test": "pnpm run test:unit && pnpm run test:e2e && pnpm run test:imports",
    "test:unit": "vitest run --config scripts/vitest.config.ts",
    "test:unit:coverage": "vitest run --config scripts/vitest.config.ts --coverage",
    "test:unit:watch": "vitest --config scripts/vitest.config.ts",
    "test:e2e": "pnpm run test:e2e:install && playwright test --config scripts/playwright.config.ts",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:e2e:ui": "pnpm run test:e2e:install && playwright test --config scripts/playwright.config.ts --ui",
    "test:es-check": "es-check es2015 dist/shave.global.js dist/jquery.shave.global.js",
    "test:perf": "node tests/performance/perf-node.test.js",
    "test:imports": "pnpm run test:imports:esm && pnpm run test:imports:cjs && pnpm run test:imports:iife",
    "test:imports:esm": "node tests/imports/test-esm.mjs",
    "test:imports:cjs": "node tests/imports/test-cjs.cjs",
    "test:imports:iife": "node tests/imports/test-iife.cjs",
    "test:size": "node scripts/check-dist-size.mjs",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/shave.git"
  },
  "keywords": [
    "ellipsis",
    "truncate",
    "truncation",
    "truncated",
    "semantic",
    "js",
    "content",
    "shorten",
    "javascript",
    "text",
    "shave",
    "trim"
  ],
  "author": "Jeff Wainwright <yowainwright@gmail.com> (jeffry.in)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yowainwright/shave/issues"
  },
  "homepage": "https://github.com/yowainwright/shave#readme",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "codependence": "^1.0.16",
    "es-check": "9.8.1",
    "happy-dom": "^21.0.4",
    "jquery": "^4.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-plugin-legibility": "^0.0.5",
    "pastoralist": "^1.14.0",
    "release-it": "^21.1.2",
    "rolldown": "^1.2.16",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "codependence": {
    "lockfile": true,
    "mode": "precise"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release-it commit"
    }
  },
  "pastoralist": {
    "appendix": {
      "basic-ftp@6.2.5": {
        "dependents": {
          "shave": "basic-ftp (required by release-it)"
        },
        "ledger": {
          "addedDate": "2026-11-01T22:58:00.126Z",
          "reason": "Security fix: basic-ftp: Quadratic-time CPU denial of service in Client.list() Unix directory-listing parser (RE_LINE backtracking) (high)",
          "source": "security",
          "securityChecked": true,
          "securityCheckDate": "2026-11-01T22:58:00.146Z",
          "securityProvider": "osv",
          "cves": [
            "CVE-2026-102990"
          ],
          "cveDetails": [
            {
              "cve": "CVE-2026-102990",
              "severity": "high",
              "patchedVersion": "6.2.1"
            }
          ],
          "severity": "high",
          "url": "https://github.com/patrickjuchli/basic-ftp/security/advisories/GHSA-c475-qrg2-pj4r",
          "vulnerableRange": ">= 0 < 6.2.1",
          "patchedVersion": "6.2.1",
          "sources": [
            "osv"
          ],
          "confidence": "possible"
        }
      }
    }
  }
}
