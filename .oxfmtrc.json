{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".github/**",
    ".codependencerc",
    ".kodiak.toml",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    "dist/**",
    "tests/**",
    "CHANGELOG.md",
    "README.md",
    "docker-compose.yml"
  ],
  "jsxSingleQuote": true,
  "printWidth": 120,
  "proseWrap": "preserve",
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": false,
  "trailingComma": "all",
  "useTabs": false
}
